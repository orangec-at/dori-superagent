#!/usr/bin/env python3
"""dori-muse-reply "<answer>" (or stdin): leaves an answer for Muse in ~/.dori/muse/inbox.jsonl (Muse reads it with
`muse-gw inbox`) and copies it to the human's Discord DM as a card, so the human sees what Muse was told."""
import fcntl, json, os, subprocess, sys, time
box = os.path.expanduser("~/.dori/muse")
os.makedirs(box, exist_ok=True)
text = (sys.argv[1] if len(sys.argv) > 1 else sys.stdin.read()).strip()
if not text:
    print("ERR empty answer"); sys.exit(1)
with open(os.path.join(box, "inbox.jsonl"), "a") as f:
    fcntl.flock(f, fcntl.LOCK_EX)
    f.write(json.dumps({"at": time.strftime("%Y-%m-%d %H:%M"), "text": text}, ensure_ascii=False) + "\n")
subprocess.run([os.path.expanduser("~/.dori/bin/dori-notify"), f"[REPORT 뮤즈] 뮤즈에게 보낸 답\n{text}"], check=False)
print("OK")
